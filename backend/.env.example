# QIS Environment Configuration Example
# Copy this file to .env and supply your local or production values

# Application Security
SECRET_KEY=qis-super-secret-key-change-in-production-min32chars
ENVIRONMENT=development

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///instance/intranet_exam_db.db

# External AI Services (Optional - graceful degradation to local models if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# Duplicate Detection Thresholds (Cosine Similarity)
DUPLICATE_HIGH_THRESHOLD=0.90
DUPLICATE_MEDIUM_THRESHOLD=0.80
DUPLICATE_LOW_THRESHOLD=0.70

# Storage Directories
UPLOAD_DIR=static/uploads

