# =============================================================================
# QIS Platform - Backend Environment Configuration Template
# Copy this file to `.env` in this directory and populate with real credentials.
# =============================================================================

# Application Security & JWT
SECRET_KEY=qis-super-secret-key-change-in-production-min32chars
JWT_SECRET=qis-super-secret-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS_STANDARD=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=30
ENVIRONMENT=development

# Database Configuration (Defaults to local active SQLite instance)
DATABASE_URL=sqlite:///instance/intranet_exam_db.db

# Frontend / CORS Origin (Used for email action links & allowed origins)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (SMTP)
# Leave blank to use local file-based outbox (backend/instance/mail_outbox.jsonl)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=no-reply@qis-assessment.com
EMAIL_USE_TLS=true

# OAuth 2.0 / OpenID Connect (Google & GitHub)
# Leave blank to keep providers unconfigured (client displays clear disabled status)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# External AI Services (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Duplicate Detection Thresholds (Cosine Similarity)
DUPLICATE_HIGH_THRESHOLD=0.90
DUPLICATE_MEDIUM_THRESHOLD=0.80
DUPLICATE_LOW_THRESHOLD=0.70

# Storage Directories
UPLOAD_DIR=static/uploads
