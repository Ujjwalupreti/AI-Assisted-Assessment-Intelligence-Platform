# QIS Environment Configuration Example (Root)
# Copy to backend/.env

SECRET_KEY=qis-super-secret-key-change-in-production-min32chars
ENVIRONMENT=development
DATABASE_URL=sqlite:///instance/intranet_exam_db.db
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173
DUPLICATE_HIGH_THRESHOLD=0.90
DUPLICATE_MEDIUM_THRESHOLD=0.80
DUPLICATE_LOW_THRESHOLD=0.70
UPLOAD_DIR=static/uploads
