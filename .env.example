# =============================================================================
# QIS Platform - Environment Configuration Template
# Copy this file to `backend/.env` and update with your environment settings.
# =============================================================================

# Application Security & JWT
SECRET_KEY=qis-super-secret-key-change-in-production-min32chars
JWT_SECRET=qis-super-secret-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS_STANDARD=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=30
ENVIRONMENT=development

# Database Configuration (Defaults to active SQLite database)
DATABASE_URL=sqlite:///instance/intranet_exam_db.db

# Frontend Client Origin (for CORS and Action Email Redirects)
FRONTEND_URL=http://localhost:5173

# Email Provider Configuration (SMTP)
# If left blank, emails are automatically logged to backend/instance/mail_outbox.jsonl for local testing
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=no-reply@qis-assessment.com
EMAIL_USE_TLS=true

# OAuth 2.0 / Social Sign-In Configuration
# Leave blank to run in mock/development mode (unconfigured providers display descriptive tooltips)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# External AI Services (Optional - graceful degradation to offline mode if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Duplicate Detection Thresholds (Cosine Similarity)
DUPLICATE_HIGH_THRESHOLD=0.90
DUPLICATE_MEDIUM_THRESHOLD=0.80
DUPLICATE_LOW_THRESHOLD=0.70

# Storage Directories
UPLOAD_DIR=static/uploads
